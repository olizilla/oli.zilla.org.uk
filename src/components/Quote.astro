---
interface Props {
  by: string
  year: string
	cite: string
}
const { by, year, cite } = Astro.props;
---

<blockquote cite={cite}>
  <div class="edge">
    <slot />
    <footer>
      <small>
        <span class="dash">—</span><a href={cite}>{by}, <time datetime={year}>{year}</time></a>
      </small>
    </footer>
  </div>
</blockquote>

<style>
  /* A quote on the homepage or /iipp: serif, with a white edge on its left
     and its source in mono below. */
  blockquote {
    max-width: var(--width-narrow);
    padding-block: var(--space-8);
    font-family: var(--serif);
    font-size: var(--type-base);
    line-height: var(--lh-snug);
  }
  .edge {
    margin-left: calc(-1 * var(--space-3));
    padding-left: var(--space-3);
    border-left: 8px solid var(--white);
  }
  footer {
    padding-top: var(--space-4);
    font-family: var(--mono);
    color: var(--muted);
  }
  .dash {
    padding-right: var(--space-1);
  }
</style>
