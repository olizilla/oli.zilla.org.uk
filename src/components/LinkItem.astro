---
import { toDataUrl } from "./Emojimg.astro";
const { href,img,title,desc,emoji = '⁂' } = Astro.props
const src = img ?? toDataUrl(emoji)
---
<a class="link-item" href={href}>
  <img src={src} alt="">
  <span class="text">
    <span class="title">{title}</span>
    <span class="desc">{desc}</span>
  </span>
</a>

<style>
  /* A row in the homepage's lists: an icon, a title and a line about it, on
     a strip of paper that reaches past the column's padding. */
  .link-item {
    display: flex;
    align-items: center;
    margin-inline: calc(-1 * var(--space-2));
    padding: var(--space-4);
    border-bottom: var(--border-1) solid var(--zinc-100);
    background: var(--paper);
  }
  img {
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-1);
  }
  .text {
    padding-left: var(--space-4);
  }
  .title {
    display: block;
    font-size: var(--type-base);
    line-height: var(--lh-snug);
    font-weight: var(--weight-bold);
    color: var(--zinc-800);
  }
  .desc {
    display: block;
    font-size: var(--type-sm);
    line-height: var(--lh-snug);
    color: var(--zinc-500);
  }
</style>
