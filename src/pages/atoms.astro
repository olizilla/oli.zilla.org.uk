    margin-bottom: 0;
  }
  .vars-summary {
    font-size: var(--type-sm);
  }
  /* The rows are added by the script, so they're outside this page's scoped
     styles: these reach them with :global(). */
  .inspect :global(td) {
    vertical-align: top;
  }
  .inspect :global(td:first-child) {
    white-space: nowrap;
  }
  .inspect :global(.decl) {
    display: inline-block;
    margin: 0 var(--space-3) var(--space-1) 0;
    white-space: nowrap;
    cursor: help;
  }
  .inspect :global(.decl.inherited)::before {
    content: "↑ ";
    color: var(--muted);
  }
  .inspect :global(.lit) {
    color: var(--muted);
