---
import { readdirSync } from 'node:fs'

// Picked from client-side so the site can be fully static
const gifs = readdirSync('public/animation')
	.filter(name => name.endsWith('.gif'))
	.map(name => `/animation/${name}`)
---
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<title>The subconscious mind</title>
	<meta name="description" content="Moving pictures from the nooks and crannies" />
	<meta name="author" content="olizilla" />
	<link rel="icon" type="image/png" href="/res/img/olizilla-icon.png" />
	<style>
html, body.full-screen, body.full-screen * {
	background-color: wheat;
	/* background-image: url('/res/img/dead-good-vibes.jpeg'); */
	display:block;
	height:100%;
	width:100%;
	border:0 none;
	margin:0;
	padding:0;
	outline-style:none;
	outline-width:0;
	outline-color:-moz-use-text-color;
}
img {position:absolute}
	</style>
	<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.4.2/jquery.min.js"></script>
	<script type="text/javascript" define:vars={{ gifs }}>
// never repeat the current gif, as an unchanged src won't fire load again
function randomGif(current) {
	var options = gifs.filter(function(gif) { return gif !== current; });
	return options[Math.floor(Math.random() * options.length)];
}
$(document).ready(function() {
	$('img').load(function() {
			$(this).fadeOut(15000, function() {
				$(this).attr("src", randomGif($(this).attr("src")));
				$(this).fadeIn(15000);
			});  
	});
	$('img').each(function() {
		$(this).attr("src", randomGif());
	});
	$('#y').attr("style", "block");
});	
	</script>
</head>
<body class="full-screen">
	<a href="/subconscious">
		<img id="x" alt="Moving pictures from the nooks and crannies of my mind" title="more more more..."/>
		<img id="y" style="display:none;" alt="Moving pictures from the nooks and crannies of my mind" title="more more more..."/>
	</a>
</body>
<!-- Images mostly from http://commons.wikimedia.org/ -->
<!-- Site design by http://theinterestedreader.co.uk -->
</html>