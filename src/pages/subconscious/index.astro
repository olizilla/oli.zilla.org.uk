---
import { readdirSync } from 'node:fs'

// Picked from client-side so the site can be fully static
const gifs = readdirSync('public/animation')
	.filter(name => name.endsWith('.gif'))
	.map(name => `/animation/${name}`)
---
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<title>The subconscious mind</title>
	<meta name="description" content="Moving pictures from the nooks and crannies" />
	<meta name="author" content="olizilla" />
	<link rel="icon" type="image/png" href="/res/img/olizilla-icon.png" />
	<style>
html, body.full-screen, body.full-screen * {
	background-color: wheat;
	/* background-image: url('/res/img/dead-good-vibes.jpeg'); */
	display:block;
	height:100%;
	width:100%;
	border:0 none;
	margin:0;
	padding:0;
	outline-style:none;
	outline-width:0;
	outline-color:-moz-use-text-color;
}
img {position:absolute}
	</style>
	<script define:vars={{ gifs }}>
// Each picture loads, fades out over 15 seconds, swaps for another gif and
// fades back in, then goes round again. y sits on top of x, so the two
// drift in and out of each other.
const FADE = 15000

// never repeat the current gif
function randomGif(current) {
	const options = gifs.filter(gif => gif !== current)
	return options[Math.floor(Math.random() * options.length)]
}

function fade(img, from, to) {
	return img.animate([{ opacity: from }, { opacity: to }], {
		duration: FADE,
		easing: 'cubic-bezier(0.37, 0, 0.63, 1)', // jQuery's swing
		fill: 'forwards',
	}).finished
}

async function cycle(img) {
	img.src = randomGif()
	for (;;) {
		// a gif that fails to load fades out and is replaced like any other
		await img.decode().catch(() => {})
		await fade(img, 1, 0)
		img.src = randomGif(img.getAttribute('src'))
		await fade(img, 0, 1)
	}
}

document.addEventListener('DOMContentLoaded', () => {
	document.getElementById('y').style.display = ''
	document.querySelectorAll('img').forEach(cycle)
})
	</script>
</head>
<body class="full-screen">
	<a href="/subconscious">
		<img id="x" alt="Moving pictures from the nooks and crannies of my mind" title="more more more..."/>
		<img id="y" style="display:none;" alt="Moving pictures from the nooks and crannies of my mind" title="more more more..."/>
	</a>
</body>
<!-- Images mostly from http://commons.wikimedia.org/ -->
