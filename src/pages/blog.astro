---
import Layout from '../layouts/2025.astro'
import { getPosts } from '../lib/posts'
import Time from '../components/Time.astro'
const title = "Is that supposed to go there? A blog by olizilla"
const tagline = "A blog by Oli Evans (olizilla) about open source, open protocols, digital public infrastructure, and web development."
const posts = await getPosts()

---
<Layout title={title} tagline={tagline} logoLink="/">
	<nav>
		{ posts.map(post => (
			<section>
					<h1>
						<a href={ post.href } class="font-extrabold">{ post.data.title }</a>
					</h1>
					<p class="text-zinc-600 pt-0 italic">{post.data.tagline}</p>
					{ post.data.image && <img src={post.data.image} alt="" /> }
					<small class="block text-right text-sm font-mono uppercase tracking-wide text-zinc-600 -mb-1 pt-2"><Time date={post.data.publishDate} /></small>
					<hr class="mt-2" />
			</section>
		)) }
	</nav>
</Layout>