---
import Layout from '../layouts/2025.astro'
import { getPosts } from '../lib/posts'
import Time from '../components/Time.astro'
const title = "Is that supposed to go there? A blog by olizilla"
const tagline = "A blog by Oli Evans (olizilla) about open source, open protocols, digital public infrastructure, and web development."
const posts = await getPosts()

---
<Layout title={title} tagline={tagline} logoLink="/">
	<nav>
		{ posts.map(post => (
			<section>
					<h1>
						<a href={ post.href }>{ post.data.title }</a>
					</h1>
					<p class="tagline">{post.data.tagline}</p>
					{ post.data.image && <img src={post.data.image} alt="" /> }
					<small class="date"><Time date={post.data.publishDate} /></small>
					<hr />
			</section>
		)) }
	</nav>
</Layout>

<style>
  /* Each post: its title as a link, its tagline, and its date on the right. */
  h1 a {
    font-weight: var(--weight-heavy);
  }
  .tagline {
    padding-top: 0;
    font-style: italic;
    color: var(--muted);
  }
  .date {
    display: block;
    margin-bottom: calc(-1 * var(--space-1));
    padding-top: var(--space-2);
    font-family: var(--mono);
    font-size: var(--type-xs);
    line-height: var(--lh-snug);
    letter-spacing: 0.025em;
    text-transform: uppercase;
    text-align: right;
    color: var(--muted);
  }
  hr {
    margin-top: var(--space-2);
  }
</style>
